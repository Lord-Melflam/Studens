// Studens database schema.
//
// One database, one schema per module, per docs/requirements.md 1.7 and
// docs/design/architecture-style.md section 12. A role per schema is granted in
// migrations, not here: that is what makes FR-B3 enforceable by the database
// rather than by convention.
//
// CROSS-SCHEMA REFERENCES ARE PLAIN IDS, NOT PRISMA RELATIONS.
// A Prisma relation must be declared on both sides, so a relation from
// ryc.ReviewAttributed to platform.Member would require a back-relation on
// Member, making tier 1 depend on tier 3. That inverts FR-B10's dependency
// direction. Plain ids also survive module extraction unchanged, which is the
// property FR-B10 and FR-B11 exist to preserve. The cost is that referential
// integrity across schemas is not enforced by Prisma; add it in a migration if
// it is ever wanted.

generator client {
  provider = "prisma-client-js"
  // multiSchema is what makes a schema per module possible, and a schema per
  // module is what makes FR-B3 enforceable by the database rather than by
  // convention (docs/design/architecture-style.md section 8). It is a Prisma
  // preview feature as of 5.22, so it is declared deliberately rather than
  // stumbled into: if it is ever removed upstream, the boundary enforcement
  // needs rethinking, not quietly dropping.
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "ref", "ryc"]
}

// ---------------------------------------------------------------------------
// platform  (tier 1)
// ---------------------------------------------------------------------------

model Tenant {
  id      String   @id @default(uuid())
  name    String
  members Member[]

  @@schema("platform")
}

model Member {
  /// FR-A6: registration is open. FR-A7: OAuth only, no stored credentials.
  id              String   @id @default(uuid())
  provider        String
  providerSubject String
  /// FR-A9: taken from the verified provider token, never from user input.
  /// FR-A10: evidence of holding an address at a domain, never proof of enrolment.
  emailDomain     String
  /// FR-A12. TWO ADDRESSES, ON PURPOSE.
  ///
  /// `providerEmail` is identity: it comes from the verified token, it is how
  /// the same person is recognised on the next sign-in, and nothing in the
  /// product may edit it. `contactEmail` is where the member asks to be
  /// reached, defaults to the provider's, and is theirs to change or clear.
  ///
  /// One editable column would let somebody edit the field their identity is
  /// matched on: at best they lock themselves out, at worst they take over
  /// somebody else's account. The trust signal in FR-A9 is derived from
  /// `providerEmail` alone, so a self-declared address can never raise it.
  ///
  /// FR-A11 reversed the earlier domain-only reading. The provider sends the
  /// address on every sign-in; refusing to keep it bought no privacy and cost
  /// the product every feature that has to reach a person.
  providerEmail   String?
  contactEmail    String?
  /// FR-A13: null until the address has been confirmed by a link sent to it.
  /// Nothing optional is sent to an unconfirmed address.
  contactVerifiedAt DateTime?
  /// OPEN-36: the provider sends a display name and we do NOT keep it. There
  /// is no column for it, so the decision is structural rather than a habit.
  /// What a Member is known by is the username below, which they choose.
  username        String?  @unique
  /// The same name with its separators removed, and the column that actually
  /// decides whether a name is free.
  ///
  /// `username` alone let `lou.martin`, `lou-martin`, `lou_martin` and
  /// `loumartin` all exist at once: four accounts that read as one person, and
  /// a username is displayed beside an opinion about a named lecturer. So the
  /// uniqueness that matters is uniqueness of what a reader sees, not of the
  /// stored string. Case is already handled, since the name is lowercased
  /// before it is checked.
  ///
  /// What this does NOT solve: letters that look like digits, `1` for `l` and
  /// `0` for `o`. Folding those too would reject legitimate names with a digit
  /// in them, so the residual risk is accepted and written down rather than
  /// half-solved. See FR-F6.
  usernameKey     String?  @unique
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  role            String   @default("member")
  createdAt       DateTime @default(now())

  /// FR-F: the first run. Null means it has not been completed, which is what
  /// sends a Member to it and what "recommencer l'introduction" resets
  /// (FR-F14). Progress is the furthest step reached, so closing the tab does
  /// not start again (FR-F5).
  onboardedAt     DateTime?
  onboardingStep  Int      @default(0)

  /// Preferences. FR-F6: only the username is required, everything here is
  /// optional. FR-F7: none of it renders on any contribution, attributed or
  /// anonymous, because a public "3rd year, SINF" beside a named review
  /// sharpens the complement attack (3.3) against every anonymous one.
  /// FR-F13: the institution is a PREFERENCE and does not set a tenant.
  locale          String?
  institutionCode String?
  studies         String?
  yearOfStudy     Int?
  interests       String?

  /// FR-H1 and FR-H2: one row per KIND, never a single "notifications" switch.
  /// A single switch is how somebody turns off the one thing they wanted in
  /// order to escape the rest. Transactional mail is not represented here at
  /// all, because it is not a preference: suppressing a confirmation that an
  /// account is being changed would hide the change from its owner.
  notifications NotificationPreference[]

  quota    MemberQuota?
  sessions Session[]

  @@unique([provider, providerSubject])
  @@index([tenantId])
  @@schema("platform")
}

/// FR-H1, FR-H2. What a Member agreed to be sent, one row per kind.
///
/// The consent record IS the row: `kind`, whether it is on, and when that was
/// last decided. Article 7(1) asks a controller to demonstrate consent, which a
/// boolean column with no date cannot do.
model NotificationPreference {
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// An identifier owned by whoever sends that kind, so a module can add one
  /// without the platform learning what it means (FR-H4).
  kind      String
  enabled   Boolean  @default(false)
  decidedAt DateTime @default(now())

  @@id([memberId, kind])
  @@schema("platform")
}

/// FR-H5: mail is queued here and sent by the worker, never inside a request.
///
/// A provider that is slow or down must not make a submission fail, and a
/// moderation decision must not be lost because mail bounced. The row is the
/// unit of retry, and it holds the ADDRESS it was queued for rather than a
/// member id, so a member deleted between queueing and sending does not drag a
/// dangling reference along, and a confirmation of deletion can still arrive.
///
/// No member id also means this table cannot be used to join a person to a
/// contribution: a module never queues mail itself (FR-H4), and FR-H3 forbids
/// any message that would reveal the author of an anonymous contribution.
model MailOutbox {
  id        String    @id @default(uuid())
  /// The recipient, captured at queue time.
  toAddress String
  /// Which message this is, so the worker picks the template and the language.
  kind      String
  locale    String    @default("fr")
  /// Template variables. Never the body: the wording lives in code and is
  /// translated at send time, so a queued message is not frozen in whatever
  /// the copy said the day it was queued.
  payload   Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  attempts  Int       @default(0)
  lastError String?

  @@index([sentAt, createdAt])
  @@schema("platform")
}

model MemberQuota {
  /// FR-C4 and design/anonymous-rate-limiting.md: a FIXED WINDOW counter.
  /// Deliberately two columns and NO per-submission timestamp. A precise
  /// timestamp here would allow joining a member to a contribution by time,
  /// which is the whole point of the accepted design. Rolling windows need
  /// exactly those timestamps, so they are forbidden too.
  memberId    String   @id
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  windowStart DateTime @db.Date
  used        Int      @default(0)

  @@schema("platform")
}

model Session {
  /// FR-A5 needs revocation, so sessions are recorded. This is a revocation
  /// check rather than a session store: any instance can still serve any
  /// request, which is the property CC-3 wanted.
  id         String    @id @default(uuid())
  /// SHA-256 of the token in the cookie. The token itself is never stored, so
  /// a stored snapshot of this table is not a set of working cookies. The
  /// FR-C3 threat model already assumes an adversary may hold one.
  /// See design/authentication.md 0.2.
  tokenHash  String    @unique
  memberId   String
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  issuedAt   DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([memberId])
  @@schema("platform")
}

/// FR-E8. A notice that something hosted here should not be.
///
/// DSA Article 16 requires every hosting provider, whatever its size, to offer
/// a mechanism for anyone to report content they consider illegal. Article 19's
/// micro-enterprise exemption covers the internal complaints system and trusted
/// flaggers; it does not cover this.
///
/// WHAT `targetKind` IS FOR. The platform does not know what a review is
/// (FR-B16) and must not learn. A report names a kind and an id, both opaque
/// here, and whichever module owns that kind is asked to act on it. A second
/// module becomes reportable by registering, not by editing this.
///
/// ON RECORDING THE REPORTER. `reporterMemberId` links a MEMBER to a
/// CONTRIBUTION, which is the shape FR-C2 forbids, and it is permitted here
/// because of which member it is: the one who REPORTED it, never the one who
/// wrote it. Knowing that somebody objected to a review says nothing about who
/// authored it. It is recorded because FR-E12's brigading signal, many reports
/// from accounts created in the same week, cannot be seen without it, and it is
/// null for anyone not signed in because FR-E8 lets anyone report.
///
/// This table is in the platform schema, so no module can read it: a module
/// that could see who reported what could correlate reporters with contributions
/// it stores. **[VERIFIED]** François, 2026-09-16.
model Report {
  id               String    @id @default(uuid())
  /// Who owns the reported thing, for example "ryc.review". Opaque here.
  targetKind       String
  targetId         String
  /// Null when the reporter was not signed in. FR-E8: anyone may report.
  reporterMemberId String?
  /// Why. A small set rather than free choice, because two of them decide
  /// whether the target is held at once (FR-E11).
  category         String
  /// Article 16(2)(a): a substantiated explanation. Required, and the reason
  /// the categories above are not enough on their own.
  detail           String
  /// Article 16(2)(c) and 16(4): optional, and the only way to tell a reporter
  /// what was decided. Stored on the report rather than on a member, because
  /// most reporters will have no account.
  contactEmail     String?
  createdAt        DateTime  @default(now())
  /// open, upheld, rejected, duplicate. Never deleted: a notice that vanished
  /// is a notice we cannot show we acted on.
  status           String    @default("open")
  decidedAt        DateTime?
  /// The moderator, never the author of the reported contribution (FR-B12).
  decidedBy        String?

  /// The queue, oldest first: what a moderator reads.
  @@index([status, createdAt])
  /// Every report about one thing, for the count FR-E12 shows.
  @@index([targetKind, targetId])
  @@schema("platform")
}

model AuditLog {
  /// FR-E1. NFR-O2: this lives in the database because the candidate free
  /// tiers retain runtime logs for as little as an hour.
  /// FR-B12: a record here may name an actor and a target, because the actor
  /// is a moderator. It must never name a contribution's AUTHOR.
  id            String   @id @default(uuid())
  actorMemberId String
  action        String
  targetKind    String
  targetId      String
  at            DateTime @default(now())

  @@index([actorMemberId])
  @@index([targetKind, targetId])
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// ref  (tier 2)  FR-B9: no data about Members.
// ---------------------------------------------------------------------------

model Institution {
  /// See requirements 1.6: identity fields here are not uncontested facts.
  ///
  /// FR-F10: institutions are DATA, not code, so adding one is a row. Seeded
  /// by migration from the list of recognised Belgian institutions.
  id         String    @id @default(uuid())
  /// Stable, lowercase, used in Member.institutionCode and in URLs.
  code       String    @unique
  name       String
  /// NO CITY. An institution is not in a city: 268 of UCLouvain's 692
  /// programmes for 2025-2026 are taught outside Louvain-la-Neuve, across
  /// eight campuses. The site is a fact about a PROGRAMME and is modelled in
  /// the catalogue, not averaged into one word here.
  /// FR-F11: name and colours, never the mark. Trademark is the blocker
  /// whatever the copyright status of a logo file. Null where the colour has
  /// not been verified: an approximation of an institution's colour is still
  /// an invented fact about it.
  colour     String?
  /// Which community recognises it. Belgium legislates higher education
  /// separately, which is why the platform cannot be monolingual (FR-G1).
  community  String?
  /// FR-F12: every institution is listed; only those whose catalogue is
  /// ingested can be chosen, and the rest say why rather than looking broken.
  available  Boolean   @default(false)
  faculties  Faculty[]
  sites      Site[]
  courses    Course[]
  programmes Programme[]

  @@schema("ref")
}

/// Where teaching happens. FR-B9: a fact about the outside world.
///
/// An institution is not in a city, a PROGRAMME is taught at a site. UCLouvain
/// publishes eight of them and 268 of its 692 programmes for 2025-2026 are
/// taught outside Louvain-la-Neuve, so this is not a detail about buildings: it
/// is what separates `sinc1ba` from `sinf1ba`, which are the same bachelor in
/// two cities. See design/catalogue-ingestion.md 10.
model Site {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  /// Slugified from the published name, so it is stable and usable in a URL.
  code          String
  /// As the institution publishes it, in the language it was crawled in.
  name          String
  programmes    Programme[]

  @@unique([institutionId, code])
  @@schema("ref")
}

/// The field of study, as the decree defines it.
///
/// NOT scoped to an institution, because the vocabulary is not one: the French
/// Community legislates the domains, and the same 24 appear across its
/// universities. An institution-scoped copy would duplicate 24 rows per
/// institution and make "all the law programmes in Belgium" a join across them.
model Domain {
  id         String      @id @default(uuid())
  code       String      @unique
  name       String
  programmes Programme[]

  @@schema("ref")
}

model Faculty {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  code          String
  name          String

  programmes Programme[]
  offerings  OfferingFaculty[]

  @@unique([institutionId, code])
  /// Redundant on its own, and the target of Programme's composite foreign key.
  /// It is what makes "a programme's institution is its faculty's institution"
  /// a fact the database enforces rather than a rule the loader remembers.
  @@unique([id, institutionId])
  @@schema("ref")
}

model Programme {
  id        String  @id @default(uuid())
  /// NULLABLE since 2026-09-18, because ULB's programmes do not always have one.
  ///
  /// Measured on 80 of its 2025 programmes: 64 name a faculty, 9 publish no
  /// organiser at all, and 7 name only a partner, "Pôle éducation" or a haute
  /// école, which are real organisers and are not ULB faculties. A fifth of the
  /// catalogue, so not an edge case to drop.
  ///
  /// Null means THE SOURCE DOES NOT STATE ONE, the same word the catalogue
  /// already uses for credits, term, site, field of study and kind. It does not
  /// mean "none": inventing a faculty row for a haute école so that a column
  /// could stay NOT NULL would have written something false into the database
  /// to keep a constraint happy.
  facultyId String?
  /// WHOSE CATALOGUE THIS CODE BELONGS TO.
  ///
  /// Derivable through the faculty, and stored anyway, because a unique index
  /// cannot span a join and `@@unique([code, year])` was wrong the moment a
  /// second institution existed: nothing stopped ULB and UCLouvain from both
  /// publishing a `ba-tecn` for 2025, and the second load would have failed
  /// with a constraint error naming neither of them.
  ///
  /// Kept honest by the composite foreign key below rather than by the loader
  /// being careful: a Programme whose institution disagrees with its faculty's
  /// cannot be written at all. That key is NOT enforced when `facultyId` is
  /// null, which is why this column has a foreign key of its own as well.
  institutionId String
  faculty   Faculty? @relation(fields: [facultyId, institutionId], references: [id, institutionId])
  /// Its own foreign key, and not only the composite one above.
  ///
  /// A composite key is not enforced when any of its columns is null, which is
  /// exactly the new case. Without this, a programme with no faculty could name
  /// an institution that does not exist and nothing would object.
  institution   Institution @relation(fields: [institutionId], references: [id])
  code      String
  year      Int
  title     String

  /// THE DIMENSIONS, STORED RATHER THAN RE-DERIVED ON EVERY READ.
  ///
  /// All three used to be pulled out of `title` by `programmeShape` each time a
  /// programme was read, so the database could not be asked for "the masters in
  /// Charleroi" and the domain had nowhere to live at all. The parse now runs
  /// once, at ingestion, and its result is a column. `read.ts` therefore stops
  /// deriving them: two sources for one fact is how they drift.
  ///
  /// Every one is nullable, and null means "not stated", never "none". A
  /// programme whose title matches no known kind keeps a null rather than being
  /// filed under the nearest one, which is the rule the parser already follows.
  kind      String?
  /// 120 or 60 for a master, from the bracket in the title. A different
  /// commitment, and a student filtering for one does not want the other.
  credits   Int?
  siteId    String?
  site      Site?   @relation(fields: [siteId], references: [id])
  domainId  String?
  domain    Domain? @relation(fields: [domainId], references: [id])

  offerings ProgrammeOffering[]

  @@unique([institutionId, code, year])
  @@index([siteId])
  @@index([domainId])
  @@index([facultyId])
  @@schema("ref")
}

model ProgrammeOffering {
  /// Which courses a programme reaches. Added 2026-09-10 for FR-D24: the
  /// schema had Programme and CourseOffering and nothing joining them, so
  /// browsing by programme was impossible even though the crawl walked exactly
  /// this relationship to find the courses in the first place.
  ///
  /// Many-to-many on both sides (FR-D25): a course appears in several
  /// programmes, and those programmes can sit in different faculties.
  programmeId String
  programme   Programme      @relation(fields: [programmeId], references: [id])
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])

  @@id([programmeId, offeringId])
  @@index([offeringId])
  @@schema("ref")
}

model Course {
  /// The STABLE identity a review attaches to. Codes are not stable across
  /// years (LINGI became LINFO, LFSAB became LEPL), so per-year data lives on
  /// CourseOffering. See catalogue-ingestion.md 3.2 and OPEN-38.
  id        String           @id @default(uuid())
  /// WHOSE CATALOGUE THIS CODE BELONGS TO, which is not the same question as
  /// who teaches the course.
  ///
  /// A course code is only unique inside one institution's catalogue.
  /// `code @unique` held while there was one catalogue and was an accident of
  /// naming after that: UCLouvain writes `lepl1503` and ULB writes
  /// `comm-b1010`, so nothing would have collided on the day, and nothing said
  /// it had to keep being true. A collision would have failed the load of a
  /// whole catalogue on one row, which is how the 78 minute crawl was lost once
  /// already (see the ects_fits_a_programme migration).
  ///
  /// NOT FR-D31's tenant. That rule is about a course UCLouvain lists and
  /// another institution teaches, and its answer is that other institution.
  /// This column answers the narrower question the unique index needs: which
  /// code space the string `code` was drawn from. FR-D30's two stated fields,
  /// which would let the tenant be read rather than guessed, are specified and
  /// not yet parsed.
  institutionId String
  institution   Institution      @relation(fields: [institutionId], references: [id])
  code      String
  offerings CourseOffering[]

  @@unique([institutionId, code])
  @@schema("ref")
}

model CourseOffering {
  /// One row per (course, academic year). `year` is the FIRST year of the
  /// academic year, matching UCLouvain's own URLs: 2025-2026 is 2025.
  id           String  @id @default(uuid())
  courseId     String
  course       Course  @relation(fields: [courseId], references: [id])
  year         Int
  title        String
  /// NULLABLE, because the official page does not always state it.
  ///
  /// Ten courses of the 6,654 in 2026-2027 publish no credits at all: the
  /// `wbcmm21021` family of post-graduate clinical biology seminars, whose
  /// pages carry the word "crédit" nowhere. They are real courses a student
  /// takes, and dropping them would lose every other field the catalogue does
  /// publish about them, which is thirty or so.
  ///
  /// This is a catalogue scraped from a source we do not control, so a field
  /// the source omits is an ordinary state to record and say plainly, never a
  /// reason to lose the course. Null means "not stated on the official page",
  /// and the interface says exactly that rather than showing a zero.
  /// `(5, 2)` and not `(4, 2)`, which held at most 99.99.
  ///
  /// The course namespace holds BUNDLE entries standing for a whole programme:
  /// `cours-2026-mcomu1000` is a three year bachelor published as one entry,
  /// worth 180 credits. The narrower column accepted every one of the 6,653
  /// other courses and rejected that one, after the crawl had spent 78 minutes
  /// collecting them, because a load is one transaction and one row it cannot
  /// store fails all of it.
  ///
  /// Sized to match the parser's own ceiling of 360, which is a six year
  /// medicine programme. Both were chosen from the measured distribution rather
  /// than from what a course ought to weigh.
  ects         Decimal? @db.Decimal(5, 2)
  language     String?
  quarter      String?
  /// FR-D19: scraped, never asked. The catalogue publishes the evaluation
  /// method with weightings.
  ///
  /// Json, not String: these are lists written in a rich text editor, three
  /// levels deep in places, and a flattened list of thirty items is unreadable.
  /// The block model is in packages/ref/src/ingestion/parse/rich.ts, with the
  /// tag counts measured across 546 pages that justify each part of it.
  /// Nothing queries inside these columns, so jsonb costs nothing here.
  assessment   Json?
  /// Official TEACHING hours. Not student effort: a different measurement
  /// from FR-D6, and must not be presented as the same thing.
  contactHours String?
  /// The rest of what the page publishes. Added 2026-09-10: the schema predated
  /// the parser, so these were missing and the database-backed catalogue could
  /// not show what the file-backed one already did.
  themes       Json?
  content      Json?
  /// The entity acronym the page names as in charge, for instance "> MECA".
  /// Text rather than a Faculty reference because it is an entity code from a
  /// different vocabulary than the faculty slugs the crawl discovers, and
  /// reconciling them is not needed to display it.
  owningFaculty String?

  faculties  OfferingFaculty[]
  teachers   OfferingTeacher[]
  programmes ProgrammeOffering[]

  @@unique([courseId, year])
  @@schema("ref")
}

model OfferingFaculty {
  /// Many-to-many on purpose. EPL students take LSM, CPME and FSA courses, so
  /// reaching a course through a faculty says nothing about who owns it.
  offeringId String
  offering   CourseOffering @relation(fields: [offeringId], references: [id])
  facultyId  String
  faculty    Faculty        @relation(fields: [facultyId], references: [id])

  @@id([offeringId, facultyId])
  @@schema("ref")
}

model OfferingTeacher {
  /// Lecturer names are third-party personal data from a public source.
  /// Permitted here (FR-B9 forbids data about MEMBERS), and the reason
  /// requirements 5.1 exists. FR-D20: no numeric field ever rates this person.
  id          String         @id @default(uuid())
  offeringId  String
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  teacherName String

  @@index([offeringId])
  @@schema("ref")
}

// ---------------------------------------------------------------------------
// ryc  (tier 3)
//
// THREE separate tables, not one with a flag. FR-C6 and FR-C20: the anonymity
// guarantee is structural, so it does not depend on application code staying
// correct forever.
// ---------------------------------------------------------------------------

model ReviewAttributed {
  /// Ordinary personal data (FR-C7). Editable by its author (FR-C14).
  /// memberId is a plain id, not a relation: see the note at the top.
  id             String   @id @default(uuid())
  /// NULL means DETACHED: the author deleted their account (FR-A15, OPEN-46
  /// resolved 2026-09-13). The text stays, the name goes.
  ///
  /// THIS IS NOT A SECOND ANONYMOUS PATH, and the difference is load bearing.
  /// A detached review renders as "deleted account", never as "Anonyme", and it
  /// is counted with neither the named nor the anonymous set. If it were
  /// counted as anonymous it would inflate the number FR-C21 shows a
  /// contributor before they choose, so the figure people use to judge their
  /// own exposure would be wrong, and 3.3's complement arithmetic with it.
  ///
  /// Postgres treats NULLs as distinct in a unique index, so many detached rows
  /// coexist under the constraint below. That is the behaviour wanted: the
  /// one-per-course rule binds a member, and there is no longer a member.
  memberId       String?
  detachedAt     DateTime?
  courseId       String
  /// FR-D4: the year the reviewer TOOK the course, chosen by them. Often years
  /// before submission, because alumni review. FR-D16: kept even when no
  /// CourseOffering row exists for that year.
  academicYear   Int
  recommendation Int
  workloadVsEcts Int
  difficulty     Int
  hoursPerWeek   Int?
  /// FR-D22: optional. FR-D23: never displayed per review, aggregate band only.
  passed         Boolean?
  body           String
  advice         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  status         String   @default("published")

  /// FR-D9: one per member per course per year, on THIS path only.
  /// FR-C13: not enforceable on the anonymous path, and FR-C17 forbids
  /// claiming otherwise in public wording.
  @@unique([memberId, courseId, academicYear])
  @@index([courseId])
  @@schema("ryc")
}

model ReviewAnonymous {
  /// NO MEMBER COLUMN OF ANY KIND. FR-C2, FR-C20. Not nullable, not renamed,
  /// not hashed. If you are about to add one, read docs/requirements.md 3.3
  /// first: the answer is no.
  ///
  /// FR-C18: a random uuid. Never a sequence, which would publish insertion
  /// order (FR-C5), and never derived from content, which would let an
  /// attacker who guesses the text confirm the row exists.
  id             String   @id @default(uuid())
  courseId       String
  academicYear   Int
  recommendation Int
  workloadVsEcts Int
  difficulty     Int
  hoursPerWeek   Int?
  passed         Boolean?
  body           String
  advice         String?
  /// Day precision, enforced by the column type. A precise timestamp here
  /// would be a de facto join key against the quota counter (FR-C5, and
  /// design/anonymous-rate-limiting.md 4.1).
  createdAt      DateTime @db.Date
  status         String   @default("published")

  /// NO tenant column. FR-C19: the tenant is derived from the course, never
  /// from the submitting member, or tenancy writes an author attribute onto
  /// an anonymous record and breaches FR-C16.
  @@index([courseId])
  @@schema("ryc")
}

model ReviewImported {
  /// FR-D17: entered by an Administrator from an external source. A third
  /// kind of record, never presented as a Member contribution: it has no
  /// member behind it, so no eligibility check and no quota applied.
  /// FR-D18: importing needs permission from whoever holds the content first
  /// (OPEN-42).
  id           String   @id @default(uuid())
  courseId     String
  academicYear Int
  body         String
  source       String
  importedBy   String
  importedAt   DateTime @default(now())
  /// FR-E8 and FR-E11, added 2026-09-16 when notice and action was built.
  ///
  /// It was missing, and its absence meant imported content could not be held:
  /// the read path returned it whatever happened, so it was the one kind of
  /// contribution nobody could report effectively. That is the wrong gap for a
  /// hosting provider to have, and worse here than elsewhere, because imported
  /// text was written somewhere else under other norms and arrives in bulk
  /// rather than one considered submission at a time.
  status       String   @default("published")

  @@index([courseId])
  @@schema("ryc")
}
