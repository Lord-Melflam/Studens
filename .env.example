# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# One database, three schemas (platform, ref, ryc), with a role per schema
# granted in migrations. See docs/design/architecture-style.md section 8.
#
# The local default uses the UNIX SOCKET with peer authentication, so there is
# no password to store, rotate or leak: PostgreSQL trusts the operating system
# user. Replace <user> with your own. Setting this project up locally involves
# no secret at all, which is deliberate.
DATABASE_URL="postgresql://<user>@localhost/studens?host=/var/run/postgresql&schema=platform"

# In production each module connects with its OWN credentials and its own pool,
# so a connection cannot escalate between schemas. Locally one user is a member
# of all three roles instead (npm run db:grant-local), which is a testing
# affordance and not the deployed shape.

# ---------------------------------------------------------------------------
# Authentication (FR-A7: OAuth only, Microsoft and Google).
#
# NAMES ONLY. A real client id or secret must never be written in this file:
# it is tracked and the repository is public. They go in .env, which is not.
# Registering the two applications is walked through end to end in
# docs/design/authentication.md, Appendix A.
#
# With none of these set, the providers are simply not offered and the
# development sign-in stays the only way in. Nothing half configured.
# ---------------------------------------------------------------------------

STUDENS_MS_CLIENT_ID=
STUDENS_MS_CLIENT_SECRET=
STUDENS_GOOGLE_CLIENT_ID=
STUDENS_GOOGLE_CLIENT_SECRET=

# Signs the short-lived sign-in state cookie. Required in production; the
# process refuses to start without it. Generate one with:
#   openssl rand -base64 32
STUDENS_SESSION_SECRET=

# Where the provider sends the browser back, and where the person lands after.
# These must match the redirect URIs registered with Microsoft and Google
# character for character. The defaults below are the local ones.
STUDENS_PUBLIC_ORIGIN=http://localhost:3001
STUDENS_APP_ORIGIN=http://localhost:5173

# Set to 1 when the app is served over HTTPS, so cookies get Secure and the
# __Host- prefix. Behind a proxy the app sees http, so this cannot be guessed.
STUDENS_SECURE_COOKIES=

# ---------------------------------------------------------------------------
# Mail (FR-H). Confirming an address change, moderation outcomes, a receipt for
# a deletion. Queued in platform.MailOutbox by the app, sent by the worker:
#
#   npm run mail              # send what is queued, once
#   npm run mail -- --watch   # keep going, every 30 seconds
#
# WITH THESE UNSET NOTHING IS SENT. The messages are still queued, so nothing
# is lost and they go out the day a relay exists, and the worker PRINTS each
# one in full so the confirmation link can be clicked in development. The
# account screen says so too rather than claiming a message is on its way.
#
# Plain SMTP with STARTTLS, no vendor and no dependency. Any relay works. The
# zero-budget starting point is a Gmail account with an APP PASSWORD (not the
# account password, and it needs two-factor enabled):
#
#   STUDENS_SMTP_HOST=smtp.gmail.com
#   STUDENS_SMTP_PORT=587
#   STUDENS_SMTP_USER=<the gmail address>
#   STUDENS_SMTP_PASS=<the 16-character app password>
#   STUDENS_MAIL_FROM=<the same gmail address>
#
# Gmail is fine for development and for the first users; it caps at a few
# hundred messages a day and the From must be the account itself, so it is not
# where this ends up. The exit is a relay on the real domain once studens.be is
# registered, which changes these five lines and nothing else.
#
# NEVER put a real password in this file: it is tracked and the repository is
# public. It goes in .env, which is not.
# ---------------------------------------------------------------------------

STUDENS_SMTP_HOST=
STUDENS_SMTP_PORT=587
STUDENS_SMTP_USER=
STUDENS_SMTP_PASS=
STUDENS_MAIL_FROM=

# ---------------------------------------------------------------------------
# Where somebody writes to argue with a moderation decision.
#
# Shown on the screen a suspended account sees at sign-in, and printed in the
# message that goes with the suspension. Both surfaces handle it being unset:
# they state the reason and the end date and say nothing about writing to
# anybody, which is better than publishing an address that bounces.
#
# NOT an administrator's own mailbox. A decision is the platform's, and the
# person who took it should not be the person a complaint has to reach; it
# also publishes a name to everybody who is ever suspended. A shared address,
# answered by whoever holds it.
# ---------------------------------------------------------------------------

STUDENS_CONTACT_EMAIL=
