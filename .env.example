# Copy to .env and adjust. .env is gitignored and must never be committed.
#
# One database, three schemas (platform, ref, ryc), with a role per schema
# granted in migrations. See docs/design/architecture-style.md section 8.
#
# The local default uses the UNIX SOCKET with peer authentication, so there is
# no password to store, rotate or leak: PostgreSQL trusts the operating system
# user. Replace <user> with your own. Setting this project up locally involves
# no secret at all, which is deliberate.
DATABASE_URL="postgresql://<user>@localhost/studens?host=/var/run/postgresql&schema=platform"

# In production each module connects with its OWN credentials and its own pool,
# so a connection cannot escalate between schemas. Locally one user is a member
# of all three roles instead (npm run db:grant-local), which is a testing
# affordance and not the deployed shape.

# ---------------------------------------------------------------------------
# Authentication (FR-A7: OAuth only, Microsoft and Google).
#
# NAMES ONLY. A real client id or secret must never be written in this file:
# it is tracked and the repository is public. They go in .env, which is not.
# Registering the two applications is walked through end to end in
# docs/design/authentication.md, Appendix A.
#
# With none of these set, the providers are simply not offered and the
# development sign-in stays the only way in. Nothing half configured.
# ---------------------------------------------------------------------------

STUDENS_MS_CLIENT_ID=
STUDENS_MS_CLIENT_SECRET=
STUDENS_GOOGLE_CLIENT_ID=
STUDENS_GOOGLE_CLIENT_SECRET=

# Signs the short-lived sign-in state cookie. Required in production; the
# process refuses to start without it. Generate one with:
#   openssl rand -base64 32
STUDENS_SESSION_SECRET=

# Where the provider sends the browser back, and where the person lands after.
# These must match the redirect URIs registered with Microsoft and Google
# character for character. The defaults below are the local ones.
STUDENS_PUBLIC_ORIGIN=http://localhost:3001
STUDENS_APP_ORIGIN=http://localhost:5173

# Set to 1 when the app is served over HTTPS, so cookies get Secure and the
# __Host- prefix. Behind a proxy the app sees http, so this cannot be guessed.
STUDENS_SECURE_COOKIES=
