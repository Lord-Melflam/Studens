{
  "name": "studens",
  "private": true,
  "version": "0.0.0",
  "description": "Modular web platform for students in higher education",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "gates": "npm run typecheck && npm run lint && npm run test && npm run schema:validate",
    "schema:validate": "DATABASE_URL=\"postgresql://validate:validate@localhost:5432/validate\" prisma validate --schema prisma/schema.prisma"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
